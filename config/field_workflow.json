  "gates": {
    "G1": {
      "fields": [
        "G1"
      ],
      "minimum_distinct_dates": 1,
      "question": "Kiểm tra quyền xe máy trên toàn hành lang, đúng chiều/rẽ và khung giờ đo; ghi biển báo và căn cứ có hiệu lực."
    },
    "G4": {
      "fields": [
        "G4"
      ],
      "minimum_distinct_dates": 1,
      "question": "Tuyến có phụ thuộc công trình hoặc phân luồng tạm không? Ghi vị trí và khoảng thời gian ảnh hưởng."
    },
    "G5": {
      "fields": [
        "G5"
      ],
      "minimum_distinct_dates": 2,
      "question": "Đối chiếu ít nhất hai ngày khảo sát để xác nhận chạy lặp cùng hành lang và khung giờ; giữ bằng chứng từng ngày."
    },
    "G6": {
      "fields": [
        "G6_start",
        "G6_end"
      ],
      "minimum_distinct_dates": 1,
      "question": "Xác nhận riêng điểm đầu và điểm cuối: chỗ dừng, thao tác thiết bị và quay đầu nếu cần."
    }
  },
  "c6": {
    "rubric_version": "source_T09_C6_0_5_v1",
