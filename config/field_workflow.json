    "supporting_fields": [
      "C6_safety",
      "C6_repeatability",
      "C6_gps",
      "C6_works",
      "C6_permission"
    ],
    "support_values": [
      "no_limitation",
      "minor",
      "moderate",
      "multiple",
      "severe",
      "infeasible"
    ],
    "score_descriptions": {
      "5": "Điểm đầu/cuối an toàn; dễ lặp; GPS ổn định; không có công trình đáng kể; không còn quyền lưu thông chưa rõ.",
      "4": "Một hạn chế nhỏ không ảnh hưởng chất lượng đo.",
      "3": "Rủi ro trung bình, cần tổ chức đo hoặc chọn thời gian.",
      "2": "Nhiều bất tiện; chỉ giữ nếu đóng góp độ phủ cao.",
      "1": "Khó triển khai lặp hoặc dữ liệu dễ sai; cần dự phòng.",
      "0": "Không khả thi; đề xuất loại hoặc đổi tuyến."
    },
    "automatic_score": false,
    "score_requires_all_supporting_fields": true,
    "only_apply_after_mandatory_gates_pass": true
  },
