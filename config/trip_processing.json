    "sources": [
      {
        "title": "TRL PPR354: A Reference Book of Driving Cycles, Version 3",
        "url": "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/4247/ppr-354.pdf",
        "location": "Appendix B: Definitions of Art.Kinema parameters, Dynamics oriented, RPA/PKE",
        "use": "RPA/PKE definitions; our explicitly documented SI interval integration is a project numerical convention."
      },
      {
        "title": "Nguyen et al. (2022), A study on the determination of the real-world driving characteristics of motorcycles in Hanoi",
        "url": "https://doi.org/10.47869/tcsj.73.4.6",
        "location": "Tables 2–3, pp. 417–419",
        "use": "Motorcycle operating parameters and PKE convention; not a validation of this project sampling design."
      }
    ],
    "design_notes": [
      "SAFD 5 km/h by 0.5 m/s2 bins are a versioned project proposal, not attributed to Nguyen (2024).",
      "Use all valid speed intervals including stationary intervals; do not fill gaps or smooth raw data.",
      "RPA and PKE share one valid-distance denominator. With this linear model and zero threshold PKE equals twice RPA.",
      "Measurements and protocol approval remain separate from successful software checks."
    ]
  }
